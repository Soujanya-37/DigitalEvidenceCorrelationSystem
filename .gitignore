# Python virtual environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.mypy_cache/

# Node.js dependencies & builds
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment & Secrets (DO NOT COMMIT)
.env
.env.*
backend/.env
backend/.env.local
*.env

# Uploads & Temporary Media (preserve directory, ignore contents)
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# SQLite / Local databases
*.db
*.sqlite
*.sqlite3

# IDE / OS specific
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
